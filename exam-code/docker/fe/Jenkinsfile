pipeline {
    agent {
        docker {
            image 'python:3.10'
        }
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-creds')
        DOCKER_REGISTRY = 'YOUR DOCKERHUB USERID'
        REPO_NAME = 'fe-exam'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/jessicamirov/devopshift-welcome.git'
            }
        }

        stage('Lint & Security Scan') {
            parallel {
                stage('Flake8 Linting') {
                    steps {
                        sh '''
                        if ! command -v flake8 &> /dev/null; then
                            echo "Installing flake8..."
                            pip install flake8
                        fi
                        flake8 frontend/mainfe.py
                        '''
                    }
                }
                stage('Bandit Security Scan') {
                    steps {
                        sh '''
                        if ! command -v bandit &> /dev/null; then
                            echo "Installing bandit..."
                            pip install bandit
                        fi
                        bandit -r frontend/mainfe.py
                        '''
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install -r frontend/requirements.txt'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                cd frontend
                docker build -t ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} .
                docker tag ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} ${DOCKER_REGISTRY}/${REPO_NAME}:latest
                """
            }
        }

        stage('Run Tests in Container') {
            steps {
                sh "docker run --rm ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} pytest tests/"
            }
        }

        stage('Integration Test with Docker Compose') {
            steps {
                sh '''
                docker-compose up -d
                sleep 10  # Allow services to start
                curl -f http://localhost:5002 || exit 1
                docker-compose down
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh '''
                echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin
                docker push ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG}
                docker push ${DOCKER_REGISTRY}/${REPO_NAME}:latest
                '''
            }
        }

        stage('Cleanup') {
            steps {
                sh 'docker-compose down || true'
                sh 'docker logout || true'
                cleanWs()
            }
        }
    }
}