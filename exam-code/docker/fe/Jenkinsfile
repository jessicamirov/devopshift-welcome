pipeline {
    agent {
        docker {
            image 'python:3.10'
        }
    }
    environment {
        // Use withCredentials instead of credentials() for better error handling
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-creds')
        DOCKER_REGISTRY = 'jessicamirov' // Replace with your actual Docker Hub username
        REPO_NAME = 'fe-exam'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    stages {
        stage('Clone Repository') {
            steps {
                checkout scm
            }
        }

        stage('Lint & Security Scan') {
            parallel {
                stage('Flake8 Linting') {
                    steps {
                        sh '''
                        if ! command -v flake8 &> /dev/null; then
                            echo "Installing flake8..."
                            if ! pip install flake8; then
                                echo "Failed to install flake8!"
                                exit 1
                            fi
                        fi
                        '''
                    }
                }
                stage('Bandit Security Scan') {
                    steps {
                        sh '''
                        pip install bandit
                        bandit -r exam-code/docker/fe || true
                        '''
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'if [ -f exam-code/docker/fe/requirements.txt ]; then pip install -r exam-code/docker/fe/requirements.txt; fi'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                cd exam-code/docker/fe
                if [ -f Dockerfile ]; then
                    docker build -t ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} .
                    docker tag ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} ${DOCKER_REGISTRY}/${REPO_NAME}:latest
                else
                    echo "Dockerfile not found"
                    exit 1
                fi
                """
            }
        }

        stage('Run Tests in Container') {
            steps {
                sh """
                if [ -d exam-code/docker/fe/tests ]; then
                    docker run --rm ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} pytest tests/ || true
                else
                    echo "Tests directory not found, skipping tests"
                fi
                """
            }
        }

        stage('Integration Test with Docker Compose') {
            steps {
                sh '''
                if [ -f docker-compose.yml ]; then
                    docker-compose up -d
                    sleep 10  # Allow services to start
                    curl -f http://localhost:5002 || echo "Frontend service not responding on port 5002"
                    docker-compose down
                else
                    echo "docker-compose.yml not found, skipping integration test"
                fi
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                    echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    docker push ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG}
                    docker push ${DOCKER_REGISTRY}/${REPO_NAME}:latest
                    '''
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                docker logout || true
                if [ -f docker-compose.yml ]; then
                    docker-compose down || true
                fi
                '''
                cleanWs()
            }
        }
    }
}